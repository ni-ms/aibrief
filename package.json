{
  "name": "fieldnotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "test": "node --test test/*.test.ts && npm run test:browser",
    "dev:server": "VITE_STORAGE_MODE=server concurrently -k -n api,web \"node --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "preview": "vite preview --host 127.0.0.1",
    "build:server": "VITE_STORAGE_MODE=server npm run build",
    "test:browser": "node --conditions=browser --test test/browser-storage.ts",
    "backup:server": "node scripts/export-local-db.ts",
    "server:start": "./server.sh start",
    "server:stop": "./server.sh stop",
    "server:status": "./server.sh status"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "@noble/hashes": "^2.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "he": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.15.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/he": "^1.2.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "imports": {
    "#platform": {
      "browser": "./src/browser/platform.ts",
      "default": "./server/platform.ts"
    }
  }
}
